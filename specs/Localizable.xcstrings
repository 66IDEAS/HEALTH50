        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su questo iPhone non c’è spazio sufficiente per creare l’esportazione. Libera spazio e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneには書き出しを作成するための空き容量が足りません。空き容量を増やしてから、もう一度お試しください。"
          }
        }
      }
    },
    "status.failed.reason.upload": {
      "comment": "Reason: the upload to Google Drive did not finish",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload to Google Drive did not finish. Check your connection, then try again."
