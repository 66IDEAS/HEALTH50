    "drive.intro.note": {
      "comment": "Google Drive sheet before sign-in, small note under the button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic export stays off until setup is finished. You can disconnect at any time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der automatische Export bleibt aus, bis die Einrichtung abgeschlossen ist. Du kannst die Verbindung jederzeit trennen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’export automatique reste désactivé jusqu’à la fin de la configuration. Vous pouvez vous déconnecter à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exportación automática permanece desactivada hasta que termine la configuración. Puedes desconectar en cualquier momento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’esportazione automatica resta disattivata fino al termine della configurazione. Puoi scollegarti in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定が完了するまで、自動書き出しはオフのままです。接続はいつでも解除できます。"
          }
        }
      }
    },
    "drive.intro.text": {
      "comment": "Google Drive sheet before sign-in, text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 uploads your health data to a folder you choose, one file per month, and keeps it current. It goes straight from this iPhone to your Google Drive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 lädt deine Gesundheitsdaten in einen Ordner deiner Wahl, eine Datei pro Monat, und hält sie aktuell. Die Daten gehen direkt von diesem iPhone in dein Google Drive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 envoie vos données de santé dans un dossier de votre choix, à raison d’un fichier par mois, et les tient à jour. Elles vont directement de cet iPhone vers votre Google Drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 sube tus datos de salud a la carpeta que elijas, un archivo por mes, y los mantiene al día. Van directamente de este iPhone a tu Google Drive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 carica i tuoi dati sanitari in una cartella a tua scelta, un file al mese, e li mantiene aggiornati. Passano direttamente da questo iPhone al tuo Google Drive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50は、選択したフォルダにヘルスケアデータを月ごとに1ファイルずつアップロードし、最新の状態に保ちます。データはこのiPhoneからGoogle ドライブへ直接送られます。"
          }
        }
      }
    },
