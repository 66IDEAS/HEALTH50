{
  "sourceLanguage": "en",
  "strings": {
    "NSHealthShareUsageDescription": {
      "comment": "Shown by iOS in the Health permission sheet. Belongs in InfoPlist.xcstrings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 reads the health data you choose so it can export it to a file or to your Google Drive. It never changes your health records."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 liest die von dir gewählten Gesundheitsdaten, um sie in eine Datei oder in dein Google Drive zu exportieren. Deine Gesundheitsdaten werden nie verändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 lit les données de santé que vous choisissez afin de les exporter dans un fichier ou vers votre Google Drive. Vos données de santé ne sont jamais modifiées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 lee los datos de salud que elijas para exportarlos a un archivo o a tu Google Drive. Nunca modifica tus datos de salud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 legge i dati sanitari che scegli per esportarli in un file o sul tuo Google Drive. Non modifica mai i tuoi dati sanitari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50は、選択されたヘルスケアデータを読み取り、ファイルまたはGoogle ドライブに書き出します。ヘルスケアデータを変更することはありません。"
          }
        }
      }
    },
    "action.saveToFiles": {
      "comment": "Primary button. Uses Apple's own wording for the Files app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save to Files…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Dateien sichern …"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer dans Fichiers…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar en Archivos…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva su File…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“ファイル”に保存…"
          }
        }
      }
    },
    "action.uploadNow": {
      "comment": "Secondary button, only shown when Google Drive is connected",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload to Google Drive now"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt in Google Drive hochladen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer maintenant vers Google Drive"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subir ahora a Google Drive"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica ora su Google Drive"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐGoogle ドライブにアップロード"
          }
        }
      }
    },
    "auto.cellular": {
      "comment": "Label of the cellular switch. Uses Apple's wording for cellular data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use cellular data"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobile Daten verwenden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser les données cellulaires"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar datos móviles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa dati cellulare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モバイルデータ通信を使用"
          }
        }
      }
    },
    "auto.drive": {
      "comment": "Label of the Google Drive row and title of the Google Drive sheet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google ドライブ"
          }
        }
      }
    },
    "auto.drive.connect": {
      "comment": "Row value when Google Drive is not connected",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続"
          }
        }
      }
    },
    "auto.every": {
      "comment": "Label of the interval row. English reads 'Every | 1 day'; the other languages use the word for 'Interval' because 'every' does not combine with a number in them.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervall"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervallo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間隔"
          }
        }
      }
    },
    "auto.footer.attention %@": {
      "comment": "Text under the section while Google Drive must be reconnected, value is a date and time",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last successful delivery %@. Health50 retries as soon as Google Drive is connected again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte erfolgreiche Übertragung %@. Health50 versucht es erneut, sobald Google Drive wieder verbunden ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernier envoi réussi %@. Health50 réessaiera dès que Google Drive sera reconnecté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Último envío correcto %@. Health50 lo reintentará en cuanto Google Drive vuelva a estar conectado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultimo invio riuscito %@. Health50 riproverà non appena Google Drive sarà di nuovo collegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の送信成功：%@。Google ドライブに再接続されると、Health50は自動的に再試行します。"
          }
        }
      }
    },
    "auto.footer.next %@": {
      "comment": "Text under the section while automatic export runs, value is an expected time such as 'tomorrow, 07:00'",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next export around %@. The interval is a target: iOS decides when Health50 may run in the background."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächster Export voraussichtlich %@. Das Intervall ist ein Richtwert: iOS entscheidet, wann Health50 im Hintergrund laufen darf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prochain export prévu : %@. L’intervalle est indicatif : iOS décide quand Health50 peut s’exécuter en arrière-plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Próxima exportación prevista: %@. El intervalo es orientativo: iOS decide cuándo puede ejecutarse Health50 en segundo plano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prossima esportazione prevista: %@. L’intervallo è indicativo: iOS decide quando Health50 può essere eseguito in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回の書き出し予定：%@頃。間隔は目安です。Health50をバックグラウンドで実行するタイミングはiOSが決定します。"
          }
        }
      }
    },
    "auto.footer.notificationsOff": {
      "comment": "Added under the section when the user declined notifications",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off, so you only see problems when you open Health50."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind deaktiviert. Probleme siehst du daher nur, wenn du Health50 öffnest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées : vous ne verrez les problèmes qu’en ouvrant Health50."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas, así que solo verás los problemas al abrir Health50."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate, quindi vedrai i problemi solo aprendo Health50."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフのため、問題はHealth50を開いたときにのみ確認できます。"
          }
        }
      }
    },
    "auto.footer.off": {
      "comment": "Text under the section while automatic export has never been set up",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps your health data current in a Google Drive folder you choose. You connect Google Drive when you turn this on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält deine Gesundheitsdaten in einem Google Drive-Ordner deiner Wahl aktuell. Google Drive verbindest du beim Einschalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde vos données de santé à jour dans un dossier Google Drive de votre choix. Vous connectez Google Drive au moment de l’activation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene tus datos de salud al día en la carpeta de Google Drive que elijas. Conectarás Google Drive al activar esta opción."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene aggiornati i tuoi dati sanitari in una cartella di Google Drive a tua scelta. Collegherai Google Drive quando attivi questa opzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したGoogle ドライブのフォルダで、ヘルスケアデータを最新の状態に保ちます。オンにするとGoogle ドライブに接続します。"
          }
        }
      }
    },
    "auto.footer.setup": {
      "comment": "Text under the section while the switch is on but Google Drive is not connected yet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Google Drive and pick a folder to start. Uploads use Wi-Fi unless you allow cellular data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Google Drive und wähle einen Ordner, um zu starten. Uploads nutzen WLAN, sofern du mobile Daten nicht erlaubst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Google Drive et choisissez un dossier pour commencer. Les envois utilisent le Wi-Fi, sauf si vous autorisez les données cellulaires."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Google Drive y elige una carpeta para empezar. Las subidas usan Wi-Fi salvo que permitas los datos móviles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega Google Drive e scegli una cartella per iniziare. I caricamenti usano il Wi-Fi, a meno che tu non consenta i dati cellulare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始するには、Google ドライブに接続してフォルダを選択してください。モバイルデータ通信を許可しない限り、アップロードにはWi-Fiを使用します。"
          }
        }
      }
    },
    "auto.footer.switchedOff": {
      "comment": "Text under the section after automatic export was turned off again",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic export is off. Your exported files stay in your Google Drive folder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der automatische Export ist aus. Deine exportierten Dateien bleiben in deinem Google Drive-Ordner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’export automatique est désactivé. Vos fichiers exportés restent dans votre dossier Google Drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exportación automática está desactivada. Tus archivos exportados permanecen en tu carpeta de Google Drive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’esportazione automatica è disattivata. I file esportati restano nella tua cartella di Google Drive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動書き出しはオフです。書き出したファイルはGoogle ドライブのフォルダに残ります。"
          }
        }
      }
    },
    "auto.footer.waiting": {
      "comment": "Text under the section in the waiting-to-retry state. Quotes the label of the cellular switch.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 retries on its own as soon as Wi-Fi is available. To upload without Wi-Fi, turn on Use cellular data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 versucht es von selbst erneut, sobald WLAN verfügbar ist. Für Uploads ohne WLAN aktiviere „Mobile Daten verwenden“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 réessaiera automatiquement dès que le Wi-Fi sera disponible. Pour envoyer sans Wi-Fi, activez « Utiliser les données cellulaires »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 lo reintentará automáticamente en cuanto haya Wi-Fi. Para subir sin Wi-Fi, activa «Usar datos móviles»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 riproverà automaticamente non appena sarà disponibile il Wi-Fi. Per caricare senza Wi-Fi, attiva “Usa dati cellulare”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fiが利用可能になると、Health50は自動的に再試行します。Wi-Fiなしでアップロードするには、「モバイルデータ通信を使用」をオンにしてください。"
          }
        }
      }
    },
    "auto.interval %lld": {
      "comment": "Value of the interval row, number of days between automatic exports",
      "extractionState": "manual",
      "localizations": {
