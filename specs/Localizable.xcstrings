    "health.footer": {
      "comment": "Text under the Health Access section",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 exports only what you allow it to read. If a data type is missing from an export, check its access here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 exportiert nur, was es lesen darf. Fehlt ein Datentyp im Export, prüfe hier den Zugriff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 n’exporte que ce que vous l’autorisez à lire. Si un type de données manque dans un export, vérifiez son accès ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 solo exporta lo que le permites leer. Si falta algún tipo de dato en una exportación, comprueba aquí su acceso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 esporta solo ciò che gli consenti di leggere. Se in un’esportazione manca un tipo di dati, controlla qui il relativo accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50は、読み取りを許可されたデータのみを書き出します。書き出しに含まれないデータタイプがある場合は、ここでアクセスを確認してください。"
          }
        }
      }
