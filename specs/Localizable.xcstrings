    "drive.disconnect.confirm.text": {
      "comment": "Text of the confirmation dialog before disconnecting",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic export stops. The files already in your Google Drive folder stay there."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der automatische Export wird beendet. Die Dateien in deinem Google Drive-Ordner bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’export automatique s’arrête. Les fichiers déjà présents dans votre dossier Google Drive y restent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exportación automática se detiene. Los archivos que ya están en tu carpeta de Google Drive permanecen allí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’esportazione automatica si interrompe. I file già presenti nella tua cartella di Google Drive restano dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動書き出しを停止します。Google ドライブのフォルダにあるファイルはそのまま残ります。"
          }
        }
      }
    },
