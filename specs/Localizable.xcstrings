    "status.noData.text": {
      "comment": "Status card text when an export found no records. Must not claim to know the cause.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 could not read any data. Usually this means access is turned off in Health, or there is no data yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 konnte keine Daten lesen. Meist ist der Zugriff in Health deaktiviert, oder es gibt noch keine Daten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 n’a pu lire aucune donnée. En général, cela signifie que l’accès est désactivé dans Santé ou qu’il n’y a pas encore de données."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 no ha podido leer ningún dato. Normalmente significa que el acceso está desactivado en Salud o que todavía no hay datos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 non è riuscito a leggere alcun dato. Di solito significa che l’accesso è disattivato in Salute o che non ci sono ancora dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50はデータを読み取れませんでした。通常は、ヘルスケアでアクセスがオフになっているか、まだデータがないことが原因です。"
          }
        }
      }
    },
    "status.noData.title": {
      "comment": "Status card headline and notification title when an export found no records",
