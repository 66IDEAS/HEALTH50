    "welcome.feature.json.text": {
      "comment": "Welcome screen, first point, text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export everything you allow as plain JSON files, ready for the tools you choose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere alles, was du freigibst, als einfache JSON-Dateien für die Werkzeuge deiner Wahl."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez tout ce que vous autorisez sous forme de simples fichiers JSON, prêts pour les outils de votre choix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta todo lo que permitas como archivos JSON sencillos, listos para las herramientas que elijas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta tutto ciò che autorizzi come semplici file JSON, pronti per gli strumenti che preferisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可したデータをすべてシンプルなJSONファイルとして書き出し、お好みのツールで利用できます。"
          }
        }
      }
    },
    "welcome.feature.json.title": {
      "comment": "Welcome screen, first point, title",
      "extractionState": "manual",
      "localizations": {
