    "welcome.feature.private.text": {
      "comment": "Welcome screen, second point, text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data goes straight from this iPhone to the place you pick. No account, no servers in between."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten gehen direkt von diesem iPhone an den Ort, den du auswählst. Kein Konto, keine Server dazwischen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données vont directement de cet iPhone vers l’emplacement que vous choisissez. Aucun compte, aucun serveur intermédiaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos van directamente de este iPhone al lugar que elijas. Sin cuenta y sin servidores intermedios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati passano direttamente da questo iPhone alla destinazione che scegli. Nessun account, nessun server intermedio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データはこのiPhoneから、選択した保存先へ直接送られます。アカウントも中継サーバも不要です。"
          }
        }
      }
    },
    "welcome.feature.private.title": {
