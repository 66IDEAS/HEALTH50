    "status.failed.reason.storage": {
      "comment": "Reason: not enough free storage on the phone",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough free space on this iPhone to create the export. Free up some space, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem iPhone ist nicht genügend Speicherplatz frei, um den Export zu erstellen. Gib Speicherplatz frei und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas assez d’espace libre sur cet iPhone pour créer l’export. Libérez de l’espace, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio libre en este iPhone para crear la exportación. Libera espacio y vuelve a intentarlo."
