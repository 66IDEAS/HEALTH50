          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 guarda un archivo por mes en esta carpeta y actualiza los meses que han cambiado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
