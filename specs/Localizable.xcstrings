    "healthSheet.text": {
      "comment": "Health data access sheet, text under the headline",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 only reads the data you allow. It never changes your health records."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 liest nur die Daten, die du freigibst. Deine Gesundheitsdaten werden nie verändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 ne lit que les données que vous autorisez. Vos données de santé ne sont jamais modifiées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 solo lee los datos que permites. Nunca modifica tus datos de salud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 legge solo i dati che autorizzi. Non modifica mai i tuoi dati sanitari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50は、許可されたデータのみを読み取ります。ヘルスケアデータを変更することはありません。"
          }
        }
      }
    },
    "notify.explain": {
      "comment": "Line shown right before the iOS notification permission dialog",
      "extractionState": "manual",
      "localizations": {
