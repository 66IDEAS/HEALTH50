    "status.ready.text": {
      "comment": "Status card text before any export",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a copy of your health data now, or let Health50 keep one up to date in Google Drive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere jetzt eine Kopie deiner Gesundheitsdaten oder lass Health50 eine Kopie in Google Drive aktuell halten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez dès maintenant une copie de vos données de santé, ou laissez Health50 en tenir une à jour dans Google Drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda ahora una copia de tus datos de salud o deja que Health50 mantenga una al día en Google Drive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva subito una copia dei tuoi dati sanitari oppure lascia che Health50 ne mantenga una aggiornata su Google Drive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアデータのコピーを今すぐ保存するか、Health50でGoogle ドライブ上のコピーを最新の状態に保てます。"
          }
        }
      }
    },
