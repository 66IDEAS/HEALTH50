    "welcome.note": {
      "comment": "Welcome screen, note above the Continue button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, iOS asks which health data Health50 may read. Share all of it or only a part."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Nächstes fragt iOS, welche Gesundheitsdaten Health50 lesen darf. Gib alles frei oder nur einen Teil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS vous demande ensuite quelles données de santé Health50 peut lire. Partagez-les toutes ou seulement une partie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A continuación, iOS te pregunta qué datos de salud puede leer Health50. Comparte todos o solo una parte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora iOS ti chiede quali dati sanitari Health50 può leggere. Condividili tutti o solo in parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に、Health50が読み取れるヘルスケアデータをiOSが確認します。すべて、または一部だけを共有できます。"
