    "privacy.note": {
      "comment": "Privacy sentence at the bottom of the main screen",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight from this iPhone to your destination. No Health50 account, no servers in between."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt von diesem iPhone an dein Ziel. Kein Health50-Konto, keine Server dazwischen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Directement de cet iPhone vers votre destination. Aucun compte Health50, aucun serveur intermédiaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Directamente de este iPhone a tu destino. Sin cuenta de Health50 y sin servidores intermedios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Direttamente da questo iPhone alla tua destinazione. Nessun account Health50, nessun server intermedio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneから保存先へ直接送信。Health50のアカウントも中継サーバもありません。"
          }
