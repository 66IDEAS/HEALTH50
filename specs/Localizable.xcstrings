    "welcome.feature.readonly.text": {
      "comment": "Welcome screen, third point, text",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 only reads. It never changes your health records."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 liest nur. Deine Gesundheitsdaten werden nie verändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 se contente de lire. Vos données de santé ne sont jamais modifiées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 solo lee. Nunca modifica tus datos de salud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 si limita a leggere. Non modifica mai i tuoi dati sanitari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50はデータを読み取るだけです。ヘルスケアデータを変更することはありません。"
          }
        }
      }
    },
