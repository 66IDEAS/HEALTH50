    "drive.folder.footer": {
      "comment": "Text under the export folder",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health50 keeps one file per month in this folder and updates the months that changed."
          }
        },
        "de": {
          "stringUnit": {
