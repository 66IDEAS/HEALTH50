          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "common.continue": {
      "comment": "Primary button on the welcome screen",
      "extractionState": "manual",
      "localizations": {
