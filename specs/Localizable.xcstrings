    "status.saved.note": {
      "comment": "Status card, small note after a successful manual save",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this folder syncs with a cloud service, the upload there may still be running."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dieser Ordner mit einem Cloud-Dienst synchronisiert wird, läuft der Upload dorthin möglicherweise noch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ce dossier est synchronisé avec un service cloud, l’envoi vers celui-ci est peut-être encore en cours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
