      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The export could not run while the iPhone was locked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Export konnte nicht ausgeführt werden, solange das iPhone gesperrt war."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’export n’a pas pu s’exécuter pendant que l’iPhone était verrouillé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exportación no ha podido ejecutarse mientras el iPhone estaba bloqueado."
          }
        },
        "it": {
          "stringUnit": {
